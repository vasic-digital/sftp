# ============================================================================
# SFTP Enterprise Management System — environment template
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is git-ignored (§11.4.30);
# NEVER commit real secrets. Placeholders below are safe to track.
#
# Every variable consumed by api/internal/config/config.go applyEnv() is
# listed below with its canonical Go-side env-var name. Variables consumed
# only by docker-compose, setup scripts, or challenge infrastructure are
# marked "compose-only" or "reserved" so operators know which runtime reads
# each one.
# ============================================================================

# ============================================================================
# PRODUCTION CHECKLIST (§11.4.108 runtime-signature)
# ----------------------------------------------------------------------------
# Before deploying to production, verify EVERY item below with captured
# evidence (log output, ss -tlnp, curl health). A "defaults should be fine"
# claim is a §11.4 PASS-bluff — every check needs a positive observation.
#
# [ ] 1.  JWT_SECRET is at least 32 random bytes (openssl rand -hex 32).
# [ ] 2.  SUPERADMIN_PASSWORD is a strong, non-default value.
# [ ] 3.  API_BIND is 127.0.0.1 (loopback) — the API is NEVER exposed to the
#         public internet directly. Production uses a reverse proxy (Caddy/
#         nginx/Traefik) for TLS termination.
# [ ] 4.  SFTP_PORT (7721) and API_PORT (7722) are open in the host firewall
#         ONLY for trusted networks. Verify: sudo ufw status / firewall-cmd --list-all.
# [ ] 5.  FIREBASE_ENABLED=false unless a real service-account JSON is present
#         and the subsystem has been smoke-tested (see docs/firebase/).
# [ ] 6.  API_CORS_ORIGIN is set to the exact SPA origin (e.g. https://sftp.example.com)
#         — NEVER "*" in production.
# [ ] 7.  DB_PATH points to persistent storage (not tmpfs). The SQLite WAL
#         journal must survive restarts.
# [ ] 8.  VAULT_DATA_DIR exists and is writable by the API process (the vault
#         stores sha512-crypt hashes in memory at runtime, backed by encrypted
#         blobs on disk).
# [ ] 9.  LOGIN_RATE_LIMIT is tuned per expected concurrent users — default 10
#         req/min/IP is conservative; raise it only with evidence.
# [ ] 10. API_TEST_MODE is unset or false in production. Test mode disables
#         the mandatory-credential check (§11.4.10).
# [ ] 11. ACCESS_TOKEN_TTL ≤ 15 minutes in production; shorter = smaller window
#         for a leaked token.
# [ ] 12. REFRESH_TOKEN_TTL ≥ 4× ACCESS_TOKEN_TTL so the user experience is
#         reasonable, but ≤ 168h (7 days) — refresh tokens are long-lived
#         credentials.
# [ ] 13. The systemd --user unit (deploy/systemd/sftp-api.service) is enabled
#         and active: systemctl --user is-active sftp-api.
# [ ] 14. The SFTP container is running rootless: podman ps --filter name=sftp_production
#         shows the container and NO rootful docker daemon is involved (§11.4.161).
# [ ] 15. All secrets (.env, service-account JSON, host keys) are chmod 600/700.
#         Verify: find . -name '.env' -o -name '*.pem' -o -name '*.key' | xargs ls -la.
# [ ] 16. Health endpoint responds: curl -s http://127.0.0.1:7722/api/v1/health | jq .
# ============================================================================

# --- SFTP server (atmoz/sftp, rootless Podman) ------------------------------
# These variables are consumed by deploy/docker-compose.yml ONLY.
# They are NOT read by the Go API config.

SFTP_PORT=7721                       # Host port mapped to container sshd :22
SFTP_IMAGE=atmoz/sftp:latest         # SFTP container image
SFTP_CONTAINER_NAME=sftp_production  # Container name
SFTP_DATA_DIR=./data                 # Host dir holding user homes + chroots; also consumed by config.go SFTP_DATA_DIR for read_only enforcement (FTP-021)
SFTP_USERS_CONF=./users.conf         # atmoz user spec file (user:pass:uid:gid:dir)

# --- Management API (Go, config.go applyEnv) ----------------------------------
# Every variable in this section is consumed by api/internal/config/config.go
# applyEnv(). The env-var name IS the canonical key — it must match the
# getenv("KEY") call in applyEnv() exactly.

API_BIND=127.0.0.1                   # Listen address (loopback by default; use 0.0.0.0 in container)
API_PORT=7722                        # Host/container port for the REST API
API_CONFIG=                          # Optional JSON/YAML config file path; env vars override file values.

# --- API container metadata (compose-only) -----------------------------------
API_CONTAINER_NAME=sftp_api          # Container name for the API service
# API_IMAGE=ghcr.io/vasic-digital/sftp-api:latest  # Uncomment when a published image exists; drop build: from compose.

# --- Database ----------------------------------------------------------------
# DB_PATH is consumed by config.go applyEnv().
# DB_DRIVER and DB_DSN are RESERVED for future Postgres support — the current
# Go config does NOT read them; they are exported by challenge scripts for
# forward compatibility.

DB_PATH=./data/sftp.db               # SQLite path (config.go: DB_PATH)
DB_DRIVER=sqlite                     # sqlite|postgres — RESERVED (not yet read by config.go)
DB_DSN=postgres://sftp:CHANGE_ME@localhost:5432/sftp?sslmode=disable  # RESERVED (not yet read by config.go)

# --- Postgres container (compose-only; only when DB_DRIVER=postgres) ----------
# These variables are consumed by deploy/docker-compose.yml ONLY.

POSTGRES_CONTAINER_NAME=sftp_postgres  # Postgres container name
POSTGRES_DB=sftp                     # Database name
POSTGRES_USER=sftp                   # Database user
POSTGRES_PASSWORD=CHANGE_ME          # Database password — set real value in .env only

# --- users.conf render target ------------------------------------------------
# USERS_CONF_PATH tells the sync layer where to render the atmoz user spec.
# This is the LIVE file (git-ignored); the TRACKED template is users.conf.example.

USERS_CONF_PATH=./data/users.conf    # config.go: USERS_CONF_PATH (default: data/users.conf)

# --- Auth / JWT --------------------------------------------------------------
# JWT_SECRET and SUPERADMIN_PASSWORD are REQUIRED outside test mode.
# The API REFUSES to start without them (config.go Validate() enforces
# JWT_SECRET >= 32 chars and SUPERADMIN_PASSWORD non-empty).

JWT_SECRET=<set-via-setup-script>    # Generated by scripts/setup — NEVER hand-edit into git. Min 32 chars.
ACCESS_TOKEN_TTL=15m                 # config.go: ACCESS_TOKEN_TTL (default 15m). Keep short in prod.
REFRESH_TOKEN_TTL=168h               # config.go: REFRESH_TOKEN_TTL (default 168h). Must exceed ACCESS_TOKEN_TTL.
JWT_ISSUER=sftp-enterprise           # RESERVED — current Go authn uses hardcoded "sftp-api"; kept for forward compat.
SUPERADMIN_USERNAME=admin            # config.go: SUPERADMIN_USERNAME (default admin)
SUPERADMIN_PASSWORD=                 # config.go: SUPERADMIN_PASSWORD — REQUIRED. Set in .env only; NEVER versioned.
# NOTE: the superadmin PASSWORD must NEVER live in this file — it is created
# interactively by the setup script and stored hashed in the DB only (§11.4.10).

# --- API version + test mode -------------------------------------------------
API_VERSION=0.1.0-dev                # config.go: API_VERSION — reported by /api/v1/health
API_TEST_MODE=false                  # config.go: API_TEST_MODE — set to true ONLY for test runs (relaxes credential checks)

# --- Rate limiting -----------------------------------------------------------
LOGIN_RATE_LIMIT=10                  # config.go: LOGIN_RATE_LIMIT — max auth requests per window per IP
LOGIN_RATE_WINDOW=1m                 # config.go: LOGIN_RATE_WINDOW — auth rate-limit window duration

# --- Firebase (Crashlytics/Analytics for mobile/web — optional) --------------
FIREBASE_ENABLED=false               # config.go: FIREBASE_ENABLED — true only with a real service-account JSON present
FIREBASE_PROJECT_ID=sftp-enterprise-dev  # config.go: FIREBASE_PROJECT_ID — Firebase project id (placeholder)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json  # config.go: FIREBASE_SERVICE_ACCOUNT_PATH — Admin SDK key (git-ignored, §11.4.10)
FIREBASE_WEB_APP_ID=                 # RESERVED — used by scripts/firebase_config.sh only (not config.go)

# --- Encrypted vault ---------------------------------------------------------
VAULT_DATA_DIR=./data/vault          # config.go: VAULT_DATA_DIR — on-disk encrypted blob storage (default data/vault)

# --- CORS --------------------------------------------------------------------
# When empty (default) no CORS headers are emitted. Set to the SPA origin
# when the API and web UI are served from different origins.
API_CORS_ORIGIN=                     # config.go: API_CORS_ORIGIN — NEVER "*" in production

# --- Logging + i18n (reserved) -----------------------------------------------
# These are exported by challenge/test scripts but are NOT yet consumed by
# config.go applyEnv(). They are reserved for future wiring.

API_LOG_LEVEL=info                   # debug|info|warn|error — RESERVED (not yet read by config.go)
I18N_DEFAULT_LANG=en                 # Default UI/API language — RESERVED (not yet read by config.go)

# --- Release naming (§11.4.151) ----------------------------------------------
HELIX_RELEASE_PREFIX=sftp            # Release tags: sftp-<version>, e.g. sftp-0.1.0-dev-0.0.1

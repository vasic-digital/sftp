# ============================================================================
# SFTP Enterprise Management System — environment template
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is git-ignored (§11.4.30);
# NEVER commit real secrets. Placeholders below are safe to track.
# ============================================================================

# --- SFTP server (atmoz/sftp, rootless Podman) ------------------------------
SFTP_PORT=7721                       # Host port mapped to container sshd :22
SFTP_IMAGE=atmoz/sftp:latest         # SFTP container image
SFTP_CONTAINER_NAME=sftp_production  # Container name
SFTP_DATA_DIR=./data                 # Host dir holding user homes + chroots
SFTP_USERS_CONF=./users.conf         # atmoz user spec file (user:pass:uid:gid:dir)

# --- Management API (Go, STREAM-2) ------------------------------------------
API_PORT=7722                        # Host port for the REST API
API_BIND=127.0.0.1                   # Bind address (loopback by default; use 0.0.0.0 for LAN)
API_LOG_LEVEL=info                   # debug|info|warn|error

# --- Database ----------------------------------------------------------------
DB_DRIVER=sqlite                     # sqlite|postgres
DB_PATH=./data/sftp.db               # SQLite path (used when DB_DRIVER=sqlite)
DB_DSN=postgres://sftp:CHANGE_ME@localhost:5432/sftp?sslmode=disable  # used when DB_DRIVER=postgres

# --- Postgres container (only when DB_DRIVER=postgres) -----------------------
POSTGRES_DB=sftp                     # Database name
POSTGRES_USER=sftp                   # Database user
POSTGRES_PASSWORD=CHANGE_ME          # Database password — set real value in .env only

# --- Auth / JWT --------------------------------------------------------------
JWT_SECRET=<set-via-setup-script>    # Generated by scripts/setup — NEVER hand-edit into git
JWT_ISSUER=sftp-enterprise           # JWT issuer claim
JWT_TTL=24h                          # Access-token lifetime
SUPERADMIN_USER=admin                # Bootstrap superadmin username.
# NOTE: the superadmin PASSWORD must NEVER live in this file — it is created
# interactively by the setup script and stored hashed in the DB only (§11.4.10).

# --- Firebase (Crashlytics/Analytics for mobile/web — optional) --------------
FIREBASE_ENABLED=false               # true only with real google-services.json present
FIREBASE_PROJECT_ID=sftp-enterprise-dev  # Firebase project id (placeholder)

# --- i18n --------------------------------------------------------------------
I18N_DEFAULT_LANG=en                 # Default UI/API language

# --- Release naming (§11.4.151) ----------------------------------------------
HELIX_RELEASE_PREFIX=sftp            # Release tags: sftp-<version>, e.g. sftp-0.1.0-dev-0.0.1

  "metadata": {
    "name": "sftp.tokens.color",
    "version": "1.0.0",
    "tier": "global + semantic",
    "model": "opendesign",
    "description": "Color design tokens for the SFTP management system. Each theme carries full 50-900 palette scales for primary, secondary, neutral and the semantic families success, warning, error, info, plus a roles map that binds semantic UI roles to palette steps.",
    "polarity_convention": "Light theme scales run 50 (lightest) -> 900 (darkest). Dark theme chromatic scales are luminance-inverted (50 darkest -> 900 lightest) so that step 500 remains the primary accent and surfaces always draw from the 50-200 range in BOTH themes. See README.md.",
    "brand_rationale": "Indigo primary = trust/security for a credential-managed file service; teal secondary = transfer/data flow; slate neutral = enterprise chrome.",
    "format": "hex #RRGGBB"
  },
